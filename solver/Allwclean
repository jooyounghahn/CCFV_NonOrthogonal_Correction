#------------------------------------------------------------------------------
# Removes the build files of ccfvPoisson and the program bin/ccfvPoisson.
#
#     <repository>/solver/Allwclean
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1                  # run from this directory

if [ -z "$WM_PROJECT_DIR" ]
then
    echo "Allwclean: no OpenFOAM environment (source the etc/bashrc of" \
         "OpenFOAM v2606 first)" 1>&2
    exit 1
fi

wclean ccfvPoisson

rm -f ../bin/ccfvPoisson
rmdir ../bin 2>/dev/null                # only if it is empty now

